---
import { listCourses, progress } from "../lib/db";
import "../styles.css";

const courses = listCourses();
const { completedUnits, requiredUnits, completed } = progress();
const error = Astro.url.searchParams.get("error");
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Course enrolment — COMP4020 prototype</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <p class="brand">ANU Course Enrolment</p>
        <nav aria-label="site">
          <a href="/">Enrolment</a>
          <a href="/readme/">About</a>
        </nav>
      </div>
    </header>
    <main>
      <h1>Course enrolment</h1>
      <p class="lede">
        Browse the catalog, see seats and prerequisites against what you've
        actually done, and enrol without leaving the page.
      </p>

      {
        error && (
          <p role="alert" class="error">
            {error}
          </p>
        )
      }

      <section class="panel" aria-labelledby="progress-heading">
        <h2 id="progress-heading">Progress</h2>
        <div class="progress-stat">
          <p class="stat-value">
            {completedUnits} <span class="stat-unit">/ {requiredUnits} units completed</span>
          </p>
          <progress
            class="meter"
            value={completedUnits}
            max={requiredUnits}
            aria-labelledby="progress-heading"
          />
        </div>
        {
          completed.length > 0 ? (
            <ul class="chip-list">
              {completed.map((course) => (
                <li class="chip">
                  {course.code} — {course.title}
                </li>
              ))}
            </ul>
          ) : (
            <p class="muted">Nothing completed yet.</p>
          )
        }
      </section>

      <section aria-labelledby="catalog-heading">
        <h2 id="catalog-heading">Catalog</h2>
        <ul class="catalog">
          {
            courses.map((course) => (
              <li class={`course-card ${course.seatsLeft <= 0 ? "is-full" : ""}`}>
                <div class="course-head">
                  <h3>
                    {course.code} — {course.title}
                  </h3>
                  <span class="units-pill">{course.units} units</span>
                </div>
                <p class={`seats ${course.seatsLeft > 0 ? "" : "seats-full"}`}>
                  {course.seatsLeft > 0
                    ? `${course.seatsLeft} / ${course.capacity} seats left`
                    : "Full"}
                </p>
                {course.prerequisites.length > 0 && (
                  <p class="prereqs">
                    Requires:{" "}
                    {course.prerequisites
                      .map((p) => `${p.code} (${p.met ? "done" : "not done"})`)
                      .join(", ")}
                  </p>
                )}

                {course.state === "completed" && (
                  <p class="badge badge-completed">Completed</p>
                )}

                {course.state === "enrolled" && (
                  <div class="actions">
                    <p class="badge badge-enrolled">Enrolled</p>
                    <form method="post" action="/api/complete">
                      <input type="hidden" name="courseId" value={course.id} />
                      <button>Mark {course.code} complete</button>
                    </form>
                    <form method="post" action="/api/drop">
                      <input type="hidden" name="courseId" value={course.id} />
                      <button>Drop {course.code}</button>
                    </form>
                  </div>
                )}

                {course.state === "none" && (
                  <form method="post" action="/api/enrol">
                    <input type="hidden" name="courseId" value={course.id} />
                    <button disabled={!course.prereqsMet || !(course.seatsLeft > 0)}>
                      Enrol in {course.code}
                    </button>
                  </form>
                )}
                {course.state === "none" && (!course.prereqsMet || !(course.seatsLeft > 0)) && (
                  <p class="blocked-note">
                    Can't enrol:{" "}
                    {!course.prereqsMet ? "prerequisites not met" : "course is full"}
                  </p>
                )}
              </li>
            ))
          }
        </ul>
      </section>
    </main>
  </body>
</html>
