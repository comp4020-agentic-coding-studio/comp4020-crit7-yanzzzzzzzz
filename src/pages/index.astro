---
import {
  getChosenSpecialisationId,
  listCourses,
  listPendingPermissionRequests,
  listSpecialisations,
  progress,
} from "../lib/db";
import "../styles.css";

const courses = listCourses();
const specialisations = listSpecialisations();
const chosenSpecialisationId = getChosenSpecialisationId();
const pendingPermissionRequests = listPendingPermissionRequests();
const { completedUnits, requiredUnits, completed } = progress();
const error = Astro.url.searchParams.get("error");
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Course enrolment — COMP4020 prototype</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <p class="brand">ANU Course Enrolment</p>
        <nav aria-label="site">
          <a href="/">Enrolment</a>
          <a href="/readme/">About</a>
        </nav>
      </div>
    </header>
    <main>
      <h1>Course enrolment</h1>
      <p class="lede">
        Browse the catalog, see seats and prerequisites against what you've
        actually done, and enrol without leaving the page.
      </p>

      {
        error && (
          <p role="alert" class="error">
            {error}
          </p>
        )
      }

      <section class="panel" aria-labelledby="progress-heading">
        <h2 id="progress-heading">Progress</h2>
        <div class="progress-stat">
          <p class="stat-value">
            {completedUnits} <span class="stat-unit">/ {requiredUnits} units completed</span>
          </p>
          <progress
            class="meter"
            value={completedUnits}
            max={requiredUnits}
            aria-labelledby="progress-heading"
          />
        </div>
        {
          completed.length > 0 ? (
            <ul class="chip-list">
              {completed.map((course) => (
                <li class="chip">
                  {course.code} — {course.title}
                </li>
              ))}
            </ul>
          ) : (
            <p class="muted">Nothing completed yet.</p>
          )
        }
      </section>

      <section class="panel" aria-labelledby="specialisation-heading">
        <h2 id="specialisation-heading">Your specialisation</h2>
        <p class="muted">
          Courses under your chosen direction are highlighted in the catalog below —
          nothing outside it is hidden, since a direction's electives can still be
          prerequisites you need for other courses.
        </p>
        <ul class="specialisation-grid">
          {
            specialisations.map((spec) => {
              const isChosen = spec.id === chosenSpecialisationId;
              return (
                <li class={`specialisation-card ${isChosen ? "is-chosen" : ""}`}>
                  <h3>{spec.name}</h3>
                  <p class="muted">{spec.summary}</p>
                  <form method="post" action="/api/choose-specialisation">
                    <input type="hidden" name="specialisationId" value={spec.id} />
                    <button disabled={isChosen}>{isChosen ? "Following ✓" : "Choose"}</button>
                  </form>
                </li>
              );
            })
          }
        </ul>
      </section>

      <section aria-labelledby="catalog-heading">
        <h2 id="catalog-heading">Catalog</h2>
        <div class="search-bar" role="search">
          <label for="course-search">Search courses</label>
          <input
            type="search"
            id="course-search"
            placeholder="Search by code or title, e.g. COMP2100"
            autocomplete="off"
          />
        </div>
        <p id="search-status" class="muted" aria-live="polite"></p>
        <ul class="catalog" id="catalog-list">
          {
            courses.map((course) => (
              <li
                class={`course-card ${course.seatsLeft <= 0 ? "is-full" : ""} ${
                  course.inChosenSpecialisation ? "in-specialisation" : ""
                }`}
                data-search={`${course.code} ${course.title}`.toLowerCase()}
              >
                <div class="course-head">
                  <h3>
                    {course.code} — {course.title}
                  </h3>
                  <span class="units-pill">{course.units} units</span>
                </div>
                <p class="specialisation-pill">{course.specialisationName ?? "Core"}</p>
                <p class={`seats ${course.seatsLeft > 0 ? "" : "seats-full"}`}>
                  {course.seatsLeft > 0
                    ? `${course.seatsLeft} / ${course.capacity} seats left`
                    : "Full"}
                </p>
                {course.prerequisites.length > 0 && (
                  <p class="prereqs">
                    Requires:{" "}
                    {course.prerequisites
                      .map((p) => `${p.code} (${p.met ? "done" : "not done"})`)
                      .join(", ")}
                  </p>
                )}

                {course.state === "completed" && (
                  <p class="badge badge-completed">Completed</p>
                )}

                {course.state === "enrolled" && (
                  <div class="actions">
                    <p class="badge badge-enrolled">Enrolled</p>
                    <form method="post" action="/api/complete">
                      <input type="hidden" name="courseId" value={course.id} />
                      <button>Mark {course.code} complete</button>
                    </form>
                    <form method="post" action="/api/drop">
                      <input type="hidden" name="courseId" value={course.id} />
                      <button>Drop {course.code}</button>
                    </form>
                  </div>
                )}

                {course.state === "none" && (() => {
                  const blocked = !course.prereqsMet || !(course.seatsLeft > 0);
                  const hasPermission = course.permissionStatus === "approved";
                  return (
                    <>
                      <form method="post" action="/api/enrol">
                        <input type="hidden" name="courseId" value={course.id} />
                        <button disabled={blocked && !hasPermission}>Enrol in {course.code}</button>
                      </form>
                      {blocked && hasPermission && (
                        <p class="muted">Permission granted — you can enrol.</p>
                      )}
                      {blocked && !hasPermission && (
                        <>
                          <p class="blocked-note">
                            Can't enrol:{" "}
                            {!course.prereqsMet ? "prerequisites not met" : "course is full"}
                          </p>
                          {course.permissionStatus === "pending" && (
                            <p class="muted">Permission requested — waiting on the convener.</p>
                          )}
                          {course.permissionStatus === "denied" && (
                            <p class="muted">Permission denied.</p>
                          )}
                          {(course.permissionStatus === "none" ||
                            course.permissionStatus === "denied") && (
                            <form method="post" action="/api/request-permission">
                              <input type="hidden" name="courseId" value={course.id} />
                              <input
                                type="text"
                                name="reason"
                                placeholder="Why do you need an exception? (optional)"
                              />
                              <button>
                                {course.permissionStatus === "denied"
                                  ? "Request again"
                                  : "Request permission to enrol"}
                              </button>
                            </form>
                          )}
                        </>
                      )}
                    </>
                  );
                })()}
              </li>
            ))
          }
        </ul>
        <p id="no-results" class="muted" hidden>
          No courses match your search.
        </p>
      </section>

      <section class="panel" aria-labelledby="permission-heading">
        <h2 id="permission-heading">Permission requests (convener view)</h2>
        <p class="muted">
          Models the other side of the same request — approve or deny one to see it
          take effect on the catalog above.
        </p>
        {
          pendingPermissionRequests.length > 0 ? (
            <ul class="permission-queue">
              {pendingPermissionRequests.map((req) => (
                <li>
                  <p>
                    <strong>
                      {req.code} — {req.title}
                    </strong>
                  </p>
                  {req.reason && <p class="permission-reason">"{req.reason}"</p>}
                  <div class="actions">
                    <form method="post" action="/api/decide-permission">
                      <input type="hidden" name="courseId" value={req.courseId} />
                      <input type="hidden" name="decision" value="approved" />
                      <button>Approve</button>
                    </form>
                    <form method="post" action="/api/decide-permission">
                      <input type="hidden" name="courseId" value={req.courseId} />
                      <input type="hidden" name="decision" value="denied" />
                      <button>Deny</button>
                    </form>
                  </div>
                </li>
              ))}
            </ul>
          ) : (
            <p class="muted">No pending requests.</p>
          )
        }
      </section>
    </main>
    <script>
      const input = document.querySelector<HTMLInputElement>("#course-search");
      const cards = Array.from(document.querySelectorAll<HTMLElement>(".course-card"));
      const status = document.querySelector<HTMLElement>("#search-status");
      const noResults = document.querySelector<HTMLElement>("#no-results");

      function applyFilter(): void {
        const query = (input?.value ?? "").trim().toLowerCase();
        let visible = 0;
        for (const card of cards) {
          const matches = query === "" || (card.dataset.search ?? "").includes(query);
          card.hidden = !matches;
          if (matches) visible += 1;
        }
        if (status) {
          status.textContent = query === "" ? "" : `${visible} of ${cards.length} courses match`;
        }
        if (noResults) noResults.hidden = visible !== 0;
      }

      input?.addEventListener("input", applyFilter);
    </script>
  </body>
</html>
